# Public domain URL managed by YunoHost (without trailing slash)
PUBLIC_BASE_URL=https://tribe.yourdomain.com

# Authentication secret (use a long random value, at least 32 characters)
JWT_SECRET=choose_a_long_random_jwt_secret_here

# MariaDB credentials
DB_USER=feeduser
DB_PASSWORD=choose_a_strong_database_password
DB_NAME=feedsocial
DB_ROOT_PASSWORD=choose_a_strong_root_password
