# Conflux — copy this to `.env` and edit before running `docker compose up`.
#
#   cp .env.example .env
#
# Generate strong values with:
#   openssl rand -hex 32

# ---------- Database ----------
DB_USER=feeduser
DB_PASSWORD=please-change-this-db-password
DB_NAME=feedsocial
# Only used by the MariaDB container to set the root password.
DB_ROOT_PASSWORD=please-change-this-root-password

# ---------- Auth ----------
# Long random hex string. If unset, the server logs a warning and falls back
# to an insecure development default — never use the default in production.
JWT_SECRET=please-change-this-to-a-long-random-secret

# ---------- Optional ----------
# Public base URL used in emails, share permalinks and user RSS feeds.
# Leave unset behind a reverse proxy to fall back to `//<Host>`.
# PUBLIC_BASE_URL=https://your-domain.example

# Feed refresher
FEED_REFRESH_MINUTES=15
FEED_WORKER=on
